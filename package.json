{
  "name": "milf-viewer",
  "productName": "MILF Viewer",
  "version": "0.1.0",
  "private": true,
  "description": "MiniLuv Intel Live Feed - always-on-top scan viewer",
  "main": ".build/main.js",
  "scripts": {
    "build:code": "node scripts/build-code.mjs",
    "build:tests": "node scripts/build-code.mjs --tests",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build:code",
    "start": "electron .",
    "pretest": "npm run build:code && npm run build:tests",
    "test": "node .build/tests/test-viewer.js && node .build/tests/test-security.js && node .build/tests/test-clipboard.js && node .build/tests/test-contracts.js",
    "prebuild": "npm run build:code",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "space.miniluv.milfviewer",
    "productName": "MILF Viewer",
    "artifactName": "MILF-Viewer-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      ".build/**/*",
      "!.build/tests/**/*",
      "renderer/index.html",
      "renderer/icon.png",
      "renderer/icon-256.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "MILF-Viewer-${version}.exe",
      "unpackDirName": "milf-viewer"
    },
    "compression": "maximum"
  }
}
